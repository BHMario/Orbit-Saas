# ==============================
# Orbit — Variables de entorno
# ==============================
# Copiar a .env y ajustar valores para el entorno local.
# NO incluir secretos reales en este archivo.
# En producción, usar un gestor de secretos o variables del sistema.

# --- Application ---
APP_ENV=development
APP_NAME=orbit
HTTP_ADDR=:8080
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080/api/v1

# --- Database ---
# Conexión principal (desarrollo)
DATABASE_URL=postgres://orbit:orbit@localhost:5432/orbit?sslmode=disable

# Conexión para tests de integración
DATABASE_TEST_URL=postgres://orbit:orbit@localhost:5432/orbit_test?sslmode=disable

# Variables usadas por Docker Compose para crear la DB
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit
POSTGRES_DB=orbit
POSTGRES_PORT=5432

# --- Sessions ---
SESSION_COOKIE_NAME=orbit_session
SESSION_TTL=168h
SESSION_SECURE_COOKIE=false

# --- CSRF ---
# Cambiar por un valor aleatorio en cada instalación.
CSRF_SECRET=replace-with-local-random-value

# --- Password hashing (Argon2id) ---
PASSWORD_HASH_MEMORY_KIB=65536
PASSWORD_HASH_ITERATIONS=3
PASSWORD_HASH_PARALLELISM=2

# --- Mail ---
# Proveedores: "console" (desarrollo), "smtp" (producción)
MAIL_PROVIDER=console
MAIL_FROM=no-reply@example.test
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# Para usar MailHog en desarrollo (docker compose --profile mail up -d):
# MAIL_PROVIDER=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# UI disponible en http://localhost:8025

# --- Logging ---
LOG_LEVEL=debug

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true

# --- WebSocket ---
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173

# --- MailHog (Docker Compose, perfil "mail") ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
